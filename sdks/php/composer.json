{
    "name": "conjoin-cloud/conjoin-sdk",
    "description": "The PHP SDK for the Conjoin API",
    "type": "library",
    "license": "MIT",
    "homepage": "https://conjoin.delalify.com",
    "support": {
        "issues": "https://github.com/conjoin-cloud/conjoin-sdk/issues",
        "source": "https://github.com/conjoin-cloud/conjoin-sdk"
    },
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "8.3.1",
        "guzzlehttp/promises": "3.1.0",
        "guzzlehttp/psr7": "3.2.0",
        "psr/http-client": "1.0.3",
        "psr/http-message": "2.0"
    },
    "autoload": {
        "psr-4": {
            "ConjoinCloud\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ConjoinCloud\\Codegen\\": "codegen/src/",
            "ConjoinCloud\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true,
        "allow-plugins": {}
    },
    "require-dev": {
        "phpstan/phpstan": "2.3.5",
        "phpstan/phpstan-strict-rules": "2.1.1",
        "phpunit/phpunit": "11.5.57",
        "squizlabs/php_codesniffer": "4.0.4"
    }
}
